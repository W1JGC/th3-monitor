# Copy this file to ~/.config/th3/secrets.env and fill in the 4 values from the
# Tuya IoT Platform (see README "One-time setup"). Keep it OUT of the repo.
TUYA_REGION=us            # us | eu | cn | in  (data-center you picked)
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_DEVICE_ID=
TUYA_TEMP_UNIT=C          # C if the sensor is set to Celsius, F if Fahrenheit
